{
  "$schema": "https://raw.githubusercontent.com/Use-Tusk/fence/main/docs/schema/fence.schema.json",
  "extends": "code",
  "filesystem": {
    "allowRead": ["../.bare", "~/.config/worktrunk/"],
    "allowWrite": ["~/.omp/"],
    "denyRead": ["/var/run/docker.sock"],
    "denyWrite": ["/var/run/docker.sock"],
  },
  "network": {
    "allowedDomains": ["*.claude.ai", "*.claude.com", "npm.jsr.io"],
  },
}
